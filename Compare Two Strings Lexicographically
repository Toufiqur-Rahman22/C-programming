#include <stdio.h>
#include <string.h>

int main() {
    char a[100], b[100];
    printf("Enter first string: ");
    gets(a);
    printf("Enter second string: ");
    gets(b);

    int cmp = strcmp(a, b);

    if(cmp == 0)
        printf("Equal");
    else if(cmp < 0)
        printf("\"%s\" comes first", a);
    else
        printf("\"%s\" comes first", b);

    return 0;
}
