#include <stdio.h>
#include <math.h>
#include <string.h>

int main() {
    char hex[20];
    int len, base = 1, dec = 0;

    printf("Enter hex: ");
    scanf("%s", hex);

    len = strlen(hex);

    for (int i = len - 1; i >= 0; i--) {
        if (hex[i] >= '0' && hex[i] <= '9')
            dec += (hex[i] - 48) * base;
        else if (hex[i] >= 'A' && hex[i] <= 'F')
            dec += (hex[i] - 55) * base;
        else if (hex[i] >= 'a' && hex[i] <= 'f')
            dec += (hex[i] - 87) * base;

        base *= 16;
    }

    printf("Decimal: %d", dec);
    return 0;
}
