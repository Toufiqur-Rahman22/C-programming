#include <stdio.h>
#include <time.h>

int main() {
    time_t now;
    time(&now);

    struct tm *local = localtime(&now);

    printf("Current Date and Time:\n");
    printf("%02d-%02d-%04d  %02d:%02d:%02d\n",
           local->tm_mday,
           local->tm_mon + 1,
           local->tm_year + 1900,
           local->tm_hour,
           local->tm_min,
           local->tm_sec);

    return 0;
}
