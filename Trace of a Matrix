#include <stdio.h>
#include <math.h>

int main() {
    int a[3][3] = {{1,2,3},{4,5,6},{7,8,9}};
    int i, j;
    int trace = 0;
    float normal = 0;

    for(i = 0; i < 3; i++)
        trace += a[i][i];

    for(i = 0; i < 3; i++)
        for(j = 0; j < 3; j++)
            normal += a[i][j] * a[i][j];

    normal = sqrt(normal);

    printf("Trace = %d\n", trace);
    printf("Normal = %.2f\n", normal);

    return 0;
}
