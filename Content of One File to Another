#include <stdio.h>

int main() {
    char f1name[50], f2name[50];
    FILE *f1, *f2;
    char ch;

    printf("Enter source file: ");
    scanf("%s", f1name);

    printf("Enter destination file: ");
    scanf("%s", f2name);

    f1 = fopen(f1name, "r");
    f2 = fopen(f2name, "a");

    if (!f1 || !f2) {
        printf("Error opening files.\n");
        return 1;
    }

    while ((ch = fgetc(f1)) != EOF)
        fputc(ch, f2);

    printf("Content appended successfully.\n");

    fclose(f1);
    fclose(f2);
    return 0;
}
