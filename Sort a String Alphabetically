#include <stdio.h>
#include <string.h>

int main() {
    char s[100], temp;
    printf("Enter string: ");
    gets(s);

    for(int i = 0; i < strlen(s); i++)
        for(int j = i + 1; j < strlen(s); j++)
            if(s[i] > s[j]) {
                temp = s[i];
                s[i] = s[j];
                s[j] = temp;
            }

    printf("Sorted string: %s", s);
    return 0;
}
