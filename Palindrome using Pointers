#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    char *start, *end;

    printf("Enter string: ");
    scanf("%s", str);

    start = str;
    end = str + strlen(str) - 1;

    int isPal = 1;
    while (start < end) {
        if (*start != *end) {
            isPal = 0;
            break;
        }
        start++;
        end--;
    }

    if (isPal)
        printf("Palindrome");
    else
        printf("Not Palindrome");

    return 0;
}
