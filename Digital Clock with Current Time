#include <stdio.h>
#include <time.h>
#include <unistd.h>

int main() {
    while (1) {
        time_t now;
        time(&now);

        struct tm *local = localtime(&now);

        printf("\rDigital Clock => %02d:%02d:%02d", 
                local->tm_hour, local->tm_min, local->tm_sec);

        fflush(stdout);
        sleep(1);     // delay for 1 second
    }

    return 0;
}
