#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[500];
    int freq[26] = {0};

    printf("Enter string: ");
    gets(str);

    for(int i = 0; str[i]; i++) {
        if(isalpha(str[i]))
            freq[tolower(str[i]) - 'a'] = 1;
    }

    for(int i = 0; i < 26; i++) {
        if(freq[i] == 0) {
            printf("Not Pangram");
            return 0;
        }
    }

    printf("Pangram!");
    return 0;
}
