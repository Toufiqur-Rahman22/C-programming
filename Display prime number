#include <stdio.h>

int main() {
    int low, high;
    printf("Enter two numbers: ");
    scanf("%d %d", &low, &high);

    for (int n = low; n <= high; n++) {
        int flag = 0;

        if (n <= 1) continue;

        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                flag = 1;
                break;
            }
        }

        if (flag == 0)
            printf("%d ", n);
    }

    return 0;
}
