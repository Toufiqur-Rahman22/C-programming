#include <stdio.h>

struct Distance {
    int feet;
    float inch;
};

int main() {
    int n;
    struct Distance d[50], total = {0, 0};

    printf("Enter number of distances: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("Enter feet and inch: ");
        scanf("%d %f", &d[i].feet, &d[i].inch);

        total.feet += d[i].feet;
        total.inch += d[i].inch;
    }

    // Convert inches to feet
    total.feet += (int)(total.inch / 12);
    total.inch = fmod(total.inch, 12);

    printf("Total Distance = %d feet %.2f inch\n", total.feet, total.inch);

    return 0;
}
