#include <stdio.h>
int main() {
    int n, temp, rev = 0;
    printf("Enter number: ");
    scanf("%d", &n);

    temp = n;
    while (temp) {
        rev = rev * 10 + temp % 10;
        temp /= 10;
    }

    if (rev == n)
        printf("Palindrome");
    else
        printf("Not Palindrome");

    return 0;
}
