#include <stdio.h>

struct Student {
    char name[50];
    int age;
    float marks;
};

int main() {
    struct Student s1 = {"Rafi", 20, 85.5}, s2;
    FILE *fp;

    fp = fopen("student.dat", "wb");
    fwrite(&s1, sizeof(s1), 1, fp);
    fclose(fp);

    fp = fopen("student.dat", "rb");
    fread(&s2, sizeof(s2), 1, fp);
    fclose(fp);

    printf("Name: %s\nAge: %d\nMarks: %.2f\n",
           s2.name, s2.age, s2.marks);

    return 0;
}
