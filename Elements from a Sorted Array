#include <stdio.h>

int main() {
    int a[7] = {1,1,2,2,3,4,4};
    int b[7], i, j = 0;

    for(i = 0; i < 7; i++) {
        if(a[i] != a[i+1]) {
            b[j++] = a[i];
        }
    }

    printf("Array after removing duplicates: ");
    for(i = 0; i < j; i++)
        printf("%d ", b[i]);

    return 0;
}
