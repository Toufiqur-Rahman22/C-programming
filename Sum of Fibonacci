#include <stdio.h>

int main() {
    int n, a = 0, b = 1, next, sum = 0;

    printf("Enter N terms: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        if (i % 2 == 0)
            sum += a;

        next = a + b;
        a = b;
        b = next;
    }

    printf("Sum = %d", sum);
    return 0;
}
