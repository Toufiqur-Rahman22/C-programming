#include <stdio.h>

int main() {
    int dec;
    int oct[50], i = 0;

    printf("Enter decimal: ");
    scanf("%d", &dec);

    while (dec != 0) {
        oct[i++] = dec % 8;
        dec /= 8;
    }

    printf("Octal: ");
    for (int j = i - 1; j >= 0; j--)
        printf("%d", oct[j]);

    return 0;
}
