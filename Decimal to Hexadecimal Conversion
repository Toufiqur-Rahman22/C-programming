#include <stdio.h>

int main() {
    int dec;
    char hex[20];
    int i = 0;

    printf("Enter decimal: ");
    scanf("%d", &dec);

    while (dec != 0) {
        int rem = dec % 16;
        if (rem < 10)
            hex[i++] = rem + 48;
        else
            hex[i++] = rem + 55;

        dec /= 16;
    }

    printf("Hex: ");
    for (int j = i - 1; j >= 0; j--)
        printf("%c", hex[j]);

    return 0;
}
