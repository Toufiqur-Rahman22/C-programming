#include <stdio.h>

int main() {
    int dec;
    int bin[50], i = 0;

    printf("Enter decimal: ");
    scanf("%d", &dec);

    while (dec > 0) {
        bin[i++] = dec % 2;
        dec /= 2;
    }

    printf("Binary: ");
    for (int j = i - 1; j >= 0; j--)
        printf("%d", bin[j]);

    return 0;
}
