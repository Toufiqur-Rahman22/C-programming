#include <stdio.h>

struct Student {
    char name[50];
    int age;
    float marks;
};

int main() {
    struct Student s = {"Toufiq", 20, 88.5}, s2;

    // Write
    FILE *f = fopen("student.bin", "wb");
    fwrite(&s, sizeof(s), 1, f);
    fclose(f);

    // Read
    f = fopen("student.bin", "rb");
    fread(&s2, sizeof(s2), 1, f);
    fclose(f);

    printf("Name: %s\nAge: %d\nMarks: %.2f\n", s2.name, s2.age, s2.marks);

    return 0;
}
