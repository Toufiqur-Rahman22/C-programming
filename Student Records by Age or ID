#include <stdio.h>

struct Student {
    int id;
    int age;
    char name[50];
};

int main() {
    struct Student s[50], temp;
    int n, choice;

    printf("Enter number of students: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("ID: ");  scanf("%d", &s[i].id);
        printf("Age: "); scanf("%d", &s[i].age);
        printf("Name: "); scanf("%s", s[i].name);
    }

    printf("\nSort by:\n1. Age\n2. ID\nChoice: ");
    scanf("%d", &choice);

    for (int i = 0; i < n - 1; i++)
        for (int j = i + 1; j < n; j++) {
            int condition = (choice == 1) ? (s[i].age > s[j].age)
                                          : (s[i].id > s[j].id);
            if (condition) {
                temp = s[i];
                s[i] = s[j];
                s[j] = temp;
            }
        }

    printf("\nSorted Records:\n");
    for (int i = 0; i < n; i++)
        printf("%d %d %s\n", s[i].id, s[i].age, s[i].name);

    return 0;
}
