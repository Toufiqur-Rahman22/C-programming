#include <stdio.h>
#include <string.h>

int main() {
    char s1[200], s2[100], result[300];
    int pos, i, j;

    printf("Enter main string: ");
    gets(s1);
    printf("Enter string to insert: ");
    gets(s2);
    printf("Enter position: ");
    scanf("%d", &pos);

    for(i = 0; i < pos; i++)
        result[i] = s1[i];

    for(j = 0; s2[j]; j++)
        result[i++] = s2[j];

    for(j = pos; s1[j]; j++)
        result[i++] = s1[j];

    result[i] = '\0';

    printf("Result: %s", result);
    return 0;
}
