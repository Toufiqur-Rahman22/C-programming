#include <stdio.h>

int main() {
    int a[3][3] = {{1,2,3},{4,5,6},{7,8,9}};
    int i, sumPrimary = 0, sumSecondary = 0;

    for(i = 0; i < 3; i++) {
        sumPrimary += a[i][i];
        sumSecondary += a[i][2 - i];
    }

    printf("Primary diagonal sum = %d\n", sumPrimary);
    printf("Secondary diagonal sum = %d\n", sumSecondary);

    return 0;
}
